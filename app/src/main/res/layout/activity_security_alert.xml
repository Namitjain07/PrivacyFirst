<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Security Alert"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="The website you opened may not be a verified banking portal. To protect your information, this session has been closed. If you believe the link is genuine, please verify it directly with your bank before proceeding."
        android:textColor="#333333"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnGoHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go back to Home"
        android:textColor="#D32F2F"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:textAllCaps="false"
        android:layout_gravity="center"
        android:backgroundTint="@android:color/transparent"
        android:layout_marginHorizontal="8dp"
        android:drawablePadding="8dp"
        android:background="@drawable/rounded_button_border" />
</LinearLayout>
